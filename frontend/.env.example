# Base URL of the Map2Drone API. Leave UNSET to use the Vercel proxy
# (vercel.json rewrites /api/* -> https://map2drone-api.onrender.com/api/*,
# same-origin, no CORS needed).
# Only set this when NOT using the proxy, e.g.:
# VITE_API_BASE=https://map2drone-api.onrender.com/api/v1
# (in that case the Render service must allow the Vercel origin in CORS_ORIGINS).
VITE_API_BASE=